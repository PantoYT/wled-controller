(footprint "TerminalBlock_3P_P3.50mm_XY302R_KF350"
	(version 20240108)
	(generator "pcbnew")
	(layer "F.Cu")
	(descr "3-pole 3.5 mm screw terminal that takes either Xinya XY302R-3P-3.5 (TME) or Cixi Kefa KF350-3.5-3P (LCSC C474893). Same pads (drill 1.2, pad 2.4): XY302R pins 0.9 x 0.5 mm, KF350 pins 0.8 mm round. The bodies sit differently on the pins: XY302R 0.7 mm behind and 8.5 mm in front (to the wire entry at +y), KF350 3.4 mm behind and 3.5 mm in front. Fab and courtyard cover both.")
